#!/usr/bin/env bash
# hermit - save a user's home folders to a drive, and put them back later.
set -euo pipefail

HERMIT_VERSION="0.1.1"
BACKUP_DIRS=(Documents Downloads Desktop Pictures Videos Music)

# _hermit_script_path SRC — resolve SRC to an absolute path, chasing any
# symlink chain with plain readlink (portable readlink -f) and landing in
# the physical directory with cd -P/pwd -P.
_hermit_script_path() {
  local src=${1:-} dir base link
  [ -n "$src" ] || return 1
  while [ -L "$src" ]; do
    link=$(readlink "$src") || return 1
    case "$link" in
      /*) src=$link ;;
      *)
        case "$src" in
          */*) src=${src%/*}/$link ;;
          *) src=./$link ;;
        esac
        ;;
    esac
  done
  case "$src" in
    */*) dir=${src%/*} base=${src##*/} ;;
    *) dir=. base=$src ;;
  esac
  [ -n "$dir" ] || dir=/
  dir=$(cd -P -- "$dir" 2>/dev/null && pwd -P) || return 1
  printf '%s/%s\n' "$dir" "$base"
}

HERMIT_SCRIPT="$(_hermit_script_path "${BASH_SOURCE[0]}")"
HERMIT_DIR="$(dirname "$HERMIT_SCRIPT")"
for lib in common paths manifest restore drive; do
  if [ ! -r "$HERMIT_DIR/lib/$lib.sh" ]; then
    echo "hermit: missing library: $HERMIT_DIR/lib/$lib.sh" >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  . "$HERMIT_DIR/lib/$lib.sh"
done

usage() {
  cat <<'EOF'
Usage: hermit <command> [options]

Commands:
  backup <drive-path>              Save home folders to <drive-path>/hermit-backup/
  restore <drive-path> [--dry-run] Put files back under $HOME from the backup

Options:
  -h, --help                       Show this help
  -V, --version                    Show the version
EOF
}

cmd_backup() {
  local drive=${1:-}

  if [ -z "$drive" ]; then
    warn "missing drive path"
    usage >&2
    exit 2
  fi

  require_cmd rsync

   if [ ! -d "$drive" ]; then
    die "$EX_DRIVE" "not a folder: $drive"
  fi

  if ! drive_probe "$drive"; then
    die "$EX_DRIVE" "cannot write to the drive (read-only, full or not permitted): $drive"
  fi

  local folder
  local -a found=()
  for folder in "${BACKUP_DIRS[@]}"; do
    if [ -d "$HOME/$folder" ] && [ ! -L "$HOME/$folder" ]; then
      found+=("$folder")
    else
      info "skipping $folder (missing or a symlink)"
    fi
  done

  if [ "${#found[@]}" -eq 0 ]; then
    error "none of the standard folders exist under $HOME"
  fi
  info "will save: ${found[*]}"

  local fstype need free need_h free_h
  local -a src_dirs=()
  fstype=$(drive_fstype "$drive")
  if fs_is_lossy "$fstype"; then
    warn "this drive uses $fstype: Linux permissions are not kept on it, so restored files may get default modes"
  fi
  for folder in "${found[@]}"; do
    src_dirs+=("$HOME/$folder")
  done
  need=$(backup_size_bytes "${src_dirs[@]}")
  free=$(drive_free_bytes "$drive") || die "$EX_DRIVE" "cannot read the free space of: $drive"
  if ! space_ok "$free" "$need"; then
    need_h=$(numfmt --to=iec-i --suffix=B "$need" 2>/dev/null) || need_h="$need bytes"
    free_h=$(numfmt --to=iec-i --suffix=B "$free" 2>/dev/null) || free_h="$free bytes"
    die "$EX_SPACE" "not enough space on the drive: need about $need_h plus 5%, only $free_h free"
  fi

  local dest="$drive/hermit-backup"
  if [ -e "$dest" ] || [ -L "$dest" ]; then
    local answer=""
    local stamp
    printf '[hermit] %s already exists. Keep it as a dated copy and make a fresh backup? [y/N] ' "$dest" >&2
    read -r answer || answer=n
    case "$answer" in
      y | Y | yes | YES)
        stamp=$(date +%Y%m%d-%H%M%S)
        mv -- "$dest" "$dest.old-$stamp" || error "could not move the old backup"
        info "old backup kept at $dest.old-$stamp"
        ;;
      *)
        warn "cancelled, nothing changed"
        exit 1
        ;;
    esac
  fi

  local files_dir="$dest/files"
  local skipped=0
  local path folder
  mkdir -p "$files_dir"

  # Flags only where the local rsync knows them: GNU has --no-links and
  # --info, openrsync (macOS) has neither and skips symlinks on its own.
  local -a rsync_extra=()
  local rsync_help
  rsync_help=$(rsync --help 2>&1) || true
  case "$rsync_help" in
    *--no-links*) rsync_extra+=(--no-links) ;;
  esac
  case "$rsync_help" in
    *--info*)
      if [ -t 1 ]; then
        rsync_extra+=(--info=progress2,nonreg0)
      else
        rsync_extra+=(--info=nonreg0)
      fi
      ;;
  esac

  info "copying: ${found[*]}"

  # One folder at a time with a trailing slash: openrsync ignores the /./
  # cut that the old single -R invocation relied on and would rebuild the
  # wrong tree. The top folder itself is then chmodded from its source,
  # because a trailing-slash copy does not carry its mode across.
  local rsync_rc=0 rc mode hermit_rc
  for folder in "${found[@]}"; do
    while IFS= read -r -d '' path; do
      warn "skipping (not a regular file): $path"
      skipped=$(( skipped + 1 ))
    done < <(find "$HOME/$folder" ! -type f ! -type d -print0 2>/dev/null)
    rc=0
    rsync -rpt ${rsync_extra[@]+"${rsync_extra[@]}"} \
      "$HOME/$folder/" "$files_dir/$folder/" || rc=$?
    case "$rc" in
      0) ;;
      24)
        warn "some files vanished while copying (changed or deleted meanwhile); the rest was saved"
        if [ "$rsync_rc" -eq 0 ]; then
          rsync_rc=24
        fi
        ;;
      23)
        warn "some files could not be copied (unreadable?); this backup is partial"
        rsync_rc=23
        ;;
      *)
        hermit_rc=$(rsync_exit_to_hermit "$rc")
        die "$hermit_rc" "rsync stopped (code $rc): is the drive still connected, and not full?"
        ;;
    esac
    mode=$(stat_mode "$HOME/$folder" 2>/dev/null) || mode=""
    if [ -n "$mode" ]; then
      chmod "$mode" "$files_dir/$folder" || warn "could not set mode on: $folder"
    fi
  done
  hermit_rc=$(rsync_exit_to_hermit "$rsync_rc")
  case "$rsync_rc" in
    0) ;;
    24) warn "some files vanished while copying (changed or deleted meanwhile); the rest was saved" ;;
    23) warn "some files could not be copied (unreadable?); this backup is partial" ;;
  esac

  manifest_build "$files_dir" "$dest/manifest.tsv" ||
    error "could not write manifest"

  meta_write "$dest/meta.env" "$HERMIT_VERSION" "$(id -un)" "$HOME" ||
    error "could not write meta.env"

  local type size
  local file_count=0 total_bytes=0 human
  while IFS=$'\t' read -r type _ size _; do
    if [ "$type" = f ]; then
      file_count=$(( file_count + 1 ))
      total_bytes=$(( total_bytes + size ))
    fi
  done < <(manifest_read "$dest/manifest.tsv")
  human=$(numfmt --to=iec-i --suffix=B "$total_bytes" 2>/dev/null) || human="$total_bytes bytes"

  info "saved ${#found[@]} folders (${found[*]}), $file_count files, $human"
  info "skipped $skipped non-regular items"

    if [ "$hermit_rc" -eq 0 ]; then
    ok "backup complete: $dest"
  else
    warn "backup finished with problems: $dest"
    exit "$hermit_rc"
  fi
}

cmd_restore() {
  local drive="" dry_run=false arg

  for arg in "$@"; do
    case "$arg" in
      --dry-run) dry_run=true ;;
      -*)
        warn "unknown option: $arg"
        usage >&2
        exit 2
        ;;
      *)
        if [ -n "$drive" ]; then
          warn "too many arguments"
          usage >&2
          exit 2
        fi
        drive=$arg
        ;;
    esac
  done

  if [ -z "$drive" ]; then
    warn "missing drive path"
    usage >&2
    exit 2
  fi

  [ -d "$drive" ] || die "$EX_DRIVE" "not a folder: $drive"
  local backup="$drive/hermit-backup"
  local manifest="$backup/manifest.tsv"
  [ -d "$backup" ] || die "$EX_BACKUP" "no Hermit backup found at: $backup"
  [ -r "$manifest" ] || die "$EX_BACKUP" "cannot read manifest: $manifest"
  [ -d "$backup/files" ] || die "$EX_BACKUP" "backup has no files folder: $backup/files"
  manifest_read "$manifest" >/dev/null 2>&1 ||
    die "$EX_BACKUP" "manifest is unreadable or has a bad header: $manifest"

  if [ "$dry_run" = true ]; then
    info "dry run: nothing will be changed"
  fi
  info "restore source: $backup"
    if [ "$dry_run" = true ]; then
    restore_dry_run "$backup"
  else
    restore_apply "$backup" || exit "$?"
  fi
}

main() {
  case "${1:-}" in
    backup)
      shift
      cmd_backup "$@"
      ;;
    restore)
      shift
      cmd_restore "$@"
      ;;
    -h | --help | help)
      usage
      ;;
    -V | --version | version)
      printf 'hermit %s\n' "$HERMIT_VERSION"
      ;;
    '')
      usage >&2
      exit 2
      ;;
    *)
      printf 'hermit: unknown command: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
